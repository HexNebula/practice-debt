# Codeforces API credentials.
#
# Copy this file to `secrets.properties` (same directory) and paste your values in. That file is
# gitignored and is never read by anything but the local application.
#
#   cp secrets.properties.example secrets.properties
#
# Generate a key pair at https://codeforces.com/settings/api — "Add API key". Codeforces shows the
# secret exactly once, so copy it immediately.
#
# Why bother: the anonymous API omits submissions made in private gym and group contests entirely.
# A handle showing 19 solved problems on its own profile returned 5 to an unauthenticated call.
# Signing requests makes the API answer as you, so the mirror sees what you see.
#
# Leave both blank to keep running unauthenticated — everything still works, it just sees less.

codeforces.api-key=
codeforces.api-secret=
